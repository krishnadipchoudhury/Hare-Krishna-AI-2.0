# Copy to .env.local for local development (`vercel dev`).
# On Vercel, add these under Project -> Settings -> Environment Variables.

# --- AI answers ---
GROQ_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=

# --- Email verification code (OTP) ---
# Any long random string (32+ characters), e.g. output of: openssl rand -hex 32
OTP_SECRET=
# From https://resend.com -> API Keys
RESEND_API_KEY=
# An address on a domain you verified in Resend
OTP_FROM_EMAIL=Hare Krishna AI <login@yourdomain.com>
